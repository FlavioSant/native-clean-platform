{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.expo", "!**/dist", "!**/android", "!**/ios"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noMagicNumbers": "error",
        "useBlockStatements": "error",
        "useConsistentArrowReturn": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "typeLike"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "variable",
                  "scope": "global"
                },
                "formats": ["CONSTANT_CASE", "camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["CONSTANT_CASE", "camelCase", "PascalCase"]
              }
            ]
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/modules/*/**"],
                "message": "Import a module through its index.ts, never a file inside it."
              }
            ]
          }
        }
      },
      "nursery": {
        "useReactFunctionComponentDefinition": {
          "level": "error",
          "options": {
            "namedComponents": "arrowFunction"
          }
        }
      },
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/theme/tokens.js"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["**/navigation/types.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "conventions": [
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "formats": ["PascalCase", "camelCase"]
                  },
                  {
                    "selector": {
                      "kind": "typeLike"
                    },
                    "formats": ["PascalCase"]
                  },
                  {
                    "selector": {
                      "kind": "variable",
                      "scope": "global"
                    },
                    "formats": ["CONSTANT_CASE", "camelCase", "PascalCase"]
                  },
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": ["CONSTANT_CASE", "camelCase", "PascalCase"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "src/lib knows nothing about React.",
                  "react-native": "src/lib knows nothing about React."
                },
                "patterns": [
                  {
                    "group": ["@/modules/**"],
                    "message": "src/lib knows no module: a module registers with it, not the other way round."
                  },
                  {
                    "group": ["@/errors", "@/errors/**"],
                    "message": "src/errors may import src/lib, never the reverse."
                  },
                  {
                    "group": ["@/components", "@/components/**"],
                    "message": "src/lib knows nothing about React."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/errors/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules/**"],
                    "message": "src/errors knows no module: a module registers its copy with it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/modules/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/modules/**"],
                    "message": "A module never imports a module, itself included: inside a module use relative paths."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
